 "components": {
  "compressor": "bought TC-class Al 2618 (forged, 5-axis milled) backswept splitter impeller D2 ~276 mm (TPS52/57-F, TCR16/18, MET18-22 class - ESTIMATE, verify with supplier drawing), our 17-vane 2.5D diffuser + axisymmetric bend / 23 deswirl vanes straight into the cool casing (no scroll, no pipe); the TC maker's scroll casing + DN250 pipe is the fallback",
  "combustor": "single vertical reverse-flow can (Kawasaki M1A-style) on the cool casing, DN300 casing, liner d210 x 588 alloy 75 (VDM), axial swirler + central gas lance (partially premixed diffusion flame), conical transition d210 -> d270 into the floating hot plenum",
  "turbine": "bought TC-class cast IN713LC radial/mixed-flow wheel D4 ~285-290 mm friction-welded to our shaft by the supplier; 2.5D nozzle ring (alloy X / 2.4665) in a floating hot plenum inside the cool pressure casing",
  "generator": "2-pole SmCo PMG 335 kW shaft continuous at 35k rpm (583 Hz): own design, active parts from a high-speed machine shop (e+a CH, or similar) or a bought HS machine (Safran GENeUS 300 FR - inquire 24/7 rating); diode bridge + 400 V AFE supply unit, start inverter <= 500 Hz (e_pmg.py)",
  "bearings": "4 + 1 hybrid ceramic angular-contact spindle bearings 40x68x15 (7008 class) on O-ring SFDs, closed oil-jet, VG 32",
  "coupling": "D2 idea scaled: bolted d30 quill with an AF24 socket sliding on the crowned AF24 hex of the core-shaft nose (+/-1 mm float, no adjustment)"
 }
